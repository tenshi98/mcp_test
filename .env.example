# ---- Base de datos (SQLite) ----
DB_PATH=./data/mcp.db

# ---- Servidor HTTP ----
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
# URL pública base (usada en metadatos OAuth y redirect_uri)
PUBLIC_URL=http://127.0.0.1:3000

# ---- Tokens ----
# Secreto (pepper) para HMAC-SHA256 de los tokens. OBLIGATORIO. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_PEPPER=cambia-esto-por-un-valor-aleatorio-de-64-hex
# Vigencia por defecto (días) de los tokens emitidos
TOKEN_TTL_DAYS=30
# Token para el modo stdio (clientes locales). Se valida igual que en HTTP.
MCP_TOKEN=

# ---- Permisos por rol (separados por coma). Ver docs/03-configuracion.md ----
ROLE_READER=records:read
ROLE_EDITOR=records:read,records:create,records:update
ROLE_ADMIN=records:read,records:create,records:update,records:delete

# ---- OAuth 2.0 (Authorization Code + PKCE). Dejar vacío para deshabilitar ----
OAUTH_PROVIDER=generic
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=
OAUTH_SCOPES=openid email profile
# Si true, un usuario OAuth sin usuario permitido con el mismo email es rechazado (recomendado)
OAUTH_REQUIRE_PREAUTHORIZED=true

# ---- Logs ----
LOG_LEVEL=info
# Archivo opcional (además de stderr)
LOG_FILE=./logs/server.log
