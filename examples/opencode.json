{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mcp-crud": {
      "type": "remote",
      "url": "http://127.0.0.1:3000/mcp",
      "enabled": true,
      "headers": { "Authorization": "Bearer mcp_<token>" }
    },
    "mcp-crud-local": {
      "type": "local",
      "command": ["node", "/RUTA/ABSOLUTA/mcp_test/src/index.js", "stdio"],
      "enabled": false,
      "environment": {
        "DB_PATH": "/RUTA/ABSOLUTA/mcp_test/data/mcp.db",
        "TOKEN_PEPPER": "<mismo valor que en .env>",
        "MCP_TOKEN": "mcp_<token>"
      }
    }
  }
}
